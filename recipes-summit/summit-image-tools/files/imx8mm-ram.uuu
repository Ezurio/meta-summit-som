uuu_version 1.5.0

# Host-side uuu provisioning script for the i.MX8MM Nitrogen rescue image.

CFG: SDPV: -vid 0x0525 -pid 0xb4a4 -chip SPL1

SDP: boot -f flash.bin
SDPV: delay 1000
SDPV: write -f flash.bin -skipspl
SDPV: jump

# Boot a temporary recovery Linux image. `download` only copies the FIT into
# DDR; U-Boot still needs an explicit boot command to start it.
FB: ucmd setenv fastboot_buffer ${loadaddr}
FB: download -f kernel.itb
FB: acmd bootm ${fastboot_buffer}
FB: done

# Stream the SWU payload over FBK file-upload and let the gadget side
# forward it directly into SWUpdate.
#FBK: ucp image-XYZ-weston-imxXXX-XYZ.swu  t:-
#FBK: done
