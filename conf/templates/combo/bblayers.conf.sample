LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BSPDIR := "${@os.path.abspath(os.path.dirname(d.getVar('FILE', True)) + '/../..')}"

BBFILES ?= ""
BBLAYERS = " \
  ${BSPDIR}/sources/meta-summit-som \
  \
  ${BSPDIR}/sources/poky/meta \
  ${BSPDIR}/sources/poky/meta-poky \
  ${BSPDIR}/sources/meta-lts-mixins \
  \
  ${BSPDIR}/sources/meta-openembedded/meta-oe \
  ${BSPDIR}/sources/meta-openembedded/meta-multimedia \
  ${BSPDIR}/sources/meta-openembedded/meta-python \
  \
  ${BSPDIR}/sources/meta-arm/meta-arm \
  ${BSPDIR}/sources/meta-arm/meta-arm-toolchain \
  \
  ${BSPDIR}/sources/meta-openembedded/meta-networking \
  ${BSPDIR}/sources/meta-openembedded/meta-filesystems \
  \
  ${BSPDIR}/sources/meta-qt6 \
  \
  ${BSPDIR}/sources/meta-swupdate \
  ${BSPDIR}/sources/meta-timesys \
  ${BSPDIR}/sources/meta-aws \
  \
  ${BSPDIR}/sources/meta-summit-radio/meta-summit-radio \
"

BBLAYERS_NXP = " \
  ${BSPDIR}/sources/meta-freescale \
  ${BSPDIR}/sources/meta-freescale-3rdparty \
  ${BSPDIR}/sources/meta-freescale-distro \
  \
  ${BSPDIR}/sources/meta-imx/meta-imx-bsp \
  ${BSPDIR}/sources/meta-imx/meta-imx-sdk \
  ${BSPDIR}/sources/meta-imx/meta-imx-ml \
"

BBLAYERS_TI = " \
  ${BSPDIR}/sources/meta-ti/meta-ti-bsp \
"

BBLAYERS_MTK = " \
  ${BSPDIR}/sources/meta-mediatek-bsp \
"

BSP_VENDOR ?= "${@ (lambda machine: next((vendor for vendor, markers in (('ti', ('am6', 'k3')), ('mtk', ('genio', 'mt8')), ('nxp', ('imx',))) if any(marker in machine for marker in markers)), 'unknown'))(d.getVar('MACHINE') or (open(d.getVar('TOPDIR') + '/conf/local.conf').read() if os.path.exists(d.getVar('TOPDIR') + '/conf/local.conf') else ''))}"

BBLAYERS += "${@d.getVar('BBLAYERS_' + d.getVar('BSP_VENDOR').upper())}"
