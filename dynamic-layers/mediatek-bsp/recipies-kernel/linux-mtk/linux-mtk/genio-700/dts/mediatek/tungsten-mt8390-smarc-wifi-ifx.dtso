/*
 * On-board SDIO LWBxx & IFxxx module
 */

/dts-v1/;
/plugin/;

&reg_wifi_en {
	startup-delay-us = <250000>;
	off-on-delay-us = <100>;
};

&mmc2 {
	status = "okay";
	vmmc-supply = <&reg_wifi_en>;
	#address-cells = <1>;
	#size-cells = <0>;

	wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&uart3 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4329-bt";
		vbat-supply = <&reg_wifi_en>;
		vddio-supply = <&reg_1v8>;
		brcm,requires-autobaud-mode;
		max-speed = <3000000>;
	};
};
