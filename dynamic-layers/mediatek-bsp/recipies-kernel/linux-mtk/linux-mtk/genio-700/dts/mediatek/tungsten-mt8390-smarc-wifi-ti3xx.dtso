/*
 * On-board SDIO TI3xx module
 */

/dts-v1/;
/plugin/;

&reg_wifi_en {
	startup-delay-us = <10000>;
	off-on-delay-us = <100>;
};

&mmc2 {
	status = "okay";
	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&uart3 {
	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en>;
		max-speed = <115200>;
	};
};
