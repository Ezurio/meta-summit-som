From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH] mt8188: keep the eMMC boot partition selected

A partition switch costs tens of ms. Make mmc_part_switch() only record the
wanted partition and let the next block access perform the switch if it is
still needed, so repeated boot partition reads stay on it. mmc_part_sync()
applies a pending switch, e.g. back to the user area before the next stage
runs. Add a boot partition write helper.

Upstream-Status: Inappropriate [Summit SoM specific]

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
index 7a7c6d0..17e3fc0 100644
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -545,6 +545,10 @@ size_t mmc_read_blocks(int lba, uintptr_t buf, size_t size)
 	       (size != 0U) &&
 	       ((size & MMC_BLOCK_MASK) == 0U));
 
+	if (mmc_part_sync() != 0) {
+		return 0;
+	}
+
 	ret = ops->prepare(lba, buf, size);
 	if (ret != 0) {
 		return 0;
@@ -613,6 +617,10 @@ size_t mmc_write_blocks(int lba, const uintptr_t buf, size_t size)
 	       ((buf & MMC_BLOCK_MASK) == 0U) &&
 	       ((size & MMC_BLOCK_MASK) == 0U));
 
+	if (mmc_part_sync() != 0) {
+		return 0;
+	}
+
 	ret = ops->prepare(lba, buf, size);
 	if (ret != 0) {
 		return 0;
@@ -676,6 +684,10 @@ size_t mmc_erase_blocks(int lba, size_t size)
 	assert(ops != NULL);
 	assert((size != 0U) && ((size & MMC_BLOCK_MASK) == 0U));
 
+	if (mmc_part_sync() != 0) {
+		return 0;
+	}
+
 	ret = mmc_send_cmd(MMC_CMD(35), lba, MMC_RESPONSE_R1, NULL);
 	if (ret != 0) {
 		return 0;
@@ -748,14 +760,38 @@ size_t mmc_rpmb_erase_blocks(int lba, size_t size)
 	return size_erased;
 }
 
-static int mmc_part_switch(unsigned int part_type)
+/*
+ * A partition switch costs tens of ms, so mmc_part_switch() only records the wanted
+ * partition and the next access performs the switch, if it is still needed.
+ */
+static int mmc_want_part = -1;	/* -1: none requested */
+static int mmc_cur_part = -1;	/* -1: unknown */
+
+int mmc_part_sync(void)
 {
 	uint8_t part_config = mmc_ext_csd[CMD_EXTCSD_PARTITION_CONFIG];
+	int ret;
+
+	if (mmc_want_part < 0 || mmc_want_part == mmc_cur_part) {
+		return 0;
+	}
 
 	part_config &= ~EXT_CSD_PART_CONFIG_ACC_MASK;
-	part_config |= part_type;
+	part_config |= mmc_want_part;
+
+	ret = mmc_send_part_switch_cmd(part_config);
+	if (ret == 0) {
+		mmc_cur_part = mmc_want_part;
+	}
 
-	return mmc_send_part_switch_cmd(part_config);
+	return ret;
+}
+
+static int mmc_part_switch(unsigned int part_type)
+{
+	mmc_want_part = (int)part_type;
+
+	return 0;
 }
 
 unsigned char mmc_current_boot_part(void)
@@ -792,6 +828,24 @@ size_t mmc_boot_part_read_blocks(int lba, uintptr_t buf, size_t size)
 	return size_read;
 }
 
+size_t mmc_boot_part_write_blocks(int lba, const uintptr_t buf, size_t size)
+{
+	size_t size_written;
+	unsigned char current_boot_part = mmc_current_boot_part();
+
+	if (current_boot_part != 1U &&
+	    current_boot_part != 2U) {
+		ERROR("Got unexpected value for active boot partition, %u\n", current_boot_part);
+		return 0;
+	}
+
+	mmc_part_switch(current_boot_part);
+	size_written = mmc_write_blocks(lba, buf, size);
+	mmc_part_switch(0);
+
+	return size_written;
+}
+
 int mmc_init(const struct mmc_ops *ops_ptr, unsigned int clk,
 	     unsigned int width, unsigned int flags,
 	     struct mmc_device_info *device_info)
diff --git a/include/drivers/mmc.h b/include/drivers/mmc.h
index f7e2651..6c03f7f 100644
--- a/include/drivers/mmc.h
+++ b/include/drivers/mmc.h
@@ -237,6 +237,8 @@ size_t mmc_rpmb_read_blocks(int lba, uintptr_t buf, size_t size);
 size_t mmc_rpmb_write_blocks(int lba, const uintptr_t buf, size_t size);
 size_t mmc_rpmb_erase_blocks(int lba, size_t size);
 size_t mmc_boot_part_read_blocks(int lba, uintptr_t buf, size_t size);
+size_t mmc_boot_part_write_blocks(int lba, const uintptr_t buf, size_t size);
+int mmc_part_sync(void);
 int mmc_init(const struct mmc_ops *ops_ptr, unsigned int clk,
 	     unsigned int width, unsigned int flags,
 	     struct mmc_device_info *device_info);
