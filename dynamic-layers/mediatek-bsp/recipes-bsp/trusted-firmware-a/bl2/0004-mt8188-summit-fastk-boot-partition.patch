From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH] mt8188: keep DRAM Fast-K data in RAM and hand it to U-Boot

With SUMMIT_EMMC_NO_GPT there is no dramk partition. BL2 reads the 16 KiB at
SUMMIT_DRAMK_OFFSET of the active boot partition into SRAM and serves libdram's
blkdev reads, writes and erases from that copy, so BL2 never writes eMMC (the
boot partitions are write protected). If libdram changed the data, the copy is
placed at SUMMIT_DRAMK_HANDOFF in DRAM with a magic and CRC32 for U-Boot to
save, and its address is passed in boot_argument.dramk_addr (0 when there is
nothing to save).

The boot argument carries a CRC32 of dramk_addr and dram_size, so U-Boot can
validate it without relying on the magic number alone.

Upstream-Status: Inappropriate [Summit SoM specific]

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
diff --git a/plat/mediatek/common/drivers/blkdev/blkdev-mmc.c b/plat/mediatek/common/drivers/blkdev/blkdev-mmc.c
index e932207b5..b86149257 100644
--- a/plat/mediatek/common/drivers/blkdev/blkdev-mmc.c
+++ b/plat/mediatek/common/drivers/blkdev/blkdev-mmc.c
@@ -5,14 +5,110 @@
 
 #include <stdint.h>
 #include <stddef.h>
+#include <stdbool.h>
 #include <string.h>
 #include <common/debug.h>
+#include <common/tf_crc32.h>
 #include <drivers/mmc.h>
 #include "blkdev.h"
+#include "blkdev-mmc.h"
 
 
 static struct blkdev g_mmc_bdev;
 
+#if defined(SUMMIT_EMMC_NO_GPT)
+/* BL2 never writes eMMC: libdram works on a RAM copy that U-Boot saves (see summit_dramk_handoff()). */
+#define SUMMIT_DRAMK_MAGIC	0x4b4d5244U	/* "DRMK" */
+
+struct summit_dramk_handoff {
+	uint32_t magic;
+	uint32_t size;
+	uint32_t crc;
+	uint32_t reserved;
+	uint8_t data[SUMMIT_DRAMK_SIZE];
+};
+
+static uint8_t dramk_data[SUMMIT_DRAMK_SIZE] __attribute__((aligned(MMC_BLOCK_SIZE)));
+static bool dramk_dirty;
+
+static int dramk_window(uint64_t off, uint64_t len)
+{
+	if (off < SUMMIT_DRAMK_OFFSET || len > SUMMIT_DRAMK_SIZE ||
+	    off - SUMMIT_DRAMK_OFFSET > SUMMIT_DRAMK_SIZE - len)
+		return -1;
+
+	return 0;
+}
+
+static int mmc_bread(struct blkdev *bdev, uint32_t blknr, uint32_t blks, uint8_t *buf,
+			uint32_t part_id)
+{
+	uint64_t off = (uint64_t)blknr * MMC_BLOCK_SIZE;
+	uint64_t len = (uint64_t)blks * MMC_BLOCK_SIZE;
+
+	if (dramk_window(off, len) != 0)
+		return -1;
+
+	memcpy(buf, &dramk_data[off - SUMMIT_DRAMK_OFFSET], len);
+	return 0;
+}
+
+static int mmc_bwrite(struct blkdev *bdev, uint32_t blknr, uint32_t blks, uint8_t *buf,
+			uint32_t part_id)
+{
+	uint64_t off = (uint64_t)blknr * MMC_BLOCK_SIZE;
+	uint64_t len = (uint64_t)blks * MMC_BLOCK_SIZE;
+
+	if (dramk_window(off, len) != 0)
+		return -1;
+
+	memcpy(&dramk_data[off - SUMMIT_DRAMK_OFFSET], buf, len);
+	dramk_dirty = true;
+	return 0;
+}
+
+/* libdram passes byte offsets and sizes here. */
+static int mmc_rase(struct blkdev *bdev, uint64_t src, uint64_t size, uint32_t part_id)
+{
+	if (dramk_window(src, size) != 0)
+		return -1;
+
+	memset(&dramk_data[src - SUMMIT_DRAMK_OFFSET], 0, size);
+	dramk_dirty = true;
+	return 0;
+}
+
+int summit_dramk_load(void)
+{
+	if (mmc_boot_part_read_blocks(SUMMIT_DRAMK_OFFSET / MMC_BLOCK_SIZE,
+				      (uintptr_t)dramk_data,
+				      SUMMIT_DRAMK_SIZE) != SUMMIT_DRAMK_SIZE) {
+		NOTICE("Fast-K data read failed\n");
+		return -1;
+	}
+
+	return 0;
+}
+
+/* Returns the DRAM address of the data U-Boot must save, or 0 if there is none. */
+uint32_t summit_dramk_handoff(void)
+{
+	struct summit_dramk_handoff *h = (struct summit_dramk_handoff *)SUMMIT_DRAMK_HANDOFF;
+
+	if (!dramk_dirty)
+		return 0;
+
+	h->magic = 0;
+	memcpy(h->data, dramk_data, SUMMIT_DRAMK_SIZE);
+	h->size = SUMMIT_DRAMK_SIZE;
+	h->crc = tf_crc32(0, dramk_data, SUMMIT_DRAMK_SIZE);
+	h->reserved = 0;
+	__asm__ volatile("dsb sy" : : : "memory");
+	h->magic = SUMMIT_DRAMK_MAGIC;
+
+	return SUMMIT_DRAMK_HANDOFF;
+}
+#else
 static int mmc_bread(struct blkdev *bdev, uint32_t blknr, uint32_t blks, uint8_t *buf,
 			uint32_t part_id)
 {
@@ -42,6 +138,7 @@ static int mmc_rase(struct blkdev *bdev, uint64_t src, uint64_t size, uint32_t p
 	} else
 		return 0;
 }
+#endif
 
 unsigned int mmc_register_blkdev(void)
 {
diff --git a/plat/mediatek/common/drivers/blkdev/blkdev-mmc.h b/plat/mediatek/common/drivers/blkdev/blkdev-mmc.h
index 113f59a2e..eff9e7021 100644
--- a/plat/mediatek/common/drivers/blkdev/blkdev-mmc.h
+++ b/plat/mediatek/common/drivers/blkdev/blkdev-mmc.h
@@ -10,4 +10,9 @@
 
 unsigned int mmc_register_blkdev(void);
 
+#if defined(SUMMIT_EMMC_NO_GPT)
+int summit_dramk_load(void);
+uint32_t summit_dramk_handoff(void);
+#endif
+
 #endif
diff --git a/plat/mediatek/common/mtk_plat_common.h b/plat/mediatek/common/mtk_plat_common.h
index 854012baa..f670fe6a3 100644
--- a/plat/mediatek/common/mtk_plat_common.h
+++ b/plat/mediatek/common/mtk_plat_common.h
@@ -62,7 +62,13 @@ struct mtk_bl31_params {
 
 struct boot_argument {
 	unsigned int magic_number;
+#if defined(SUMMIT_EMMC_NO_GPT)
+	unsigned int dramk_addr;	/* takes the padding before dram_size, layout is unchanged */
+#endif
 	uint64_t dram_size;
+#if defined(SUMMIT_EMMC_NO_GPT)
+	unsigned int crc;		/* CRC32 of dramk_addr and dram_size, written last */
+#endif
 #if CONFIG_MTK_MBLOCK_SUPPORT
 	struct mblock_info_t mblock_info;
 #endif
diff --git a/plat/mediatek/mt8188/bl2_plat_setup.c b/plat/mediatek/mt8188/bl2_plat_setup.c
index b9f3bab89..0191969e6 100644
--- a/plat/mediatek/mt8188/bl2_plat_setup.c
+++ b/plat/mediatek/mt8188/bl2_plat_setup.c
@@ -9,6 +9,7 @@
 #include <arch_helpers.h>
 #include <common/bl_common.h>
 #include <common/debug.h>
+#include <common/tf_crc32.h>
 #include <drivers/console.h>
 #include <drivers/generic_delay_timer.h>
 #include <plat/common/common_def.h>
@@ -470,7 +471,8 @@ void bl2_platform_setup(void)
 #endif
 	mtk_io_setup();
 	#if defined(SUMMIT_EMMC_NO_GPT)
-	blkdev_set_dramk_data_offset(0);
+	/* Fast-K data is read from the boot partition; U-Boot saves new data (see summit_dramk_handoff()). */
+	blkdev_set_dramk_data_offset(summit_dramk_load() == 0 ? SUMMIT_DRAMK_OFFSET : 0);
 	#else
 	load_partition_table(GPT_IMAGE_ID);
 	blkdev_set_dramk_data_offset(get_part_addr("dramk"));
@@ -481,6 +483,9 @@ void bl2_platform_setup(void)
 	/* Share the detected DRAM capacity through MediaTek's boot arguments. */
 	BOOT_ARGUMENT->magic_number = 0;
 	BOOT_ARGUMENT->dram_size = platform_memory_size();
+	BOOT_ARGUMENT->dramk_addr = summit_dramk_handoff();
+	BOOT_ARGUMENT->crc = tf_crc32(0, (const uint8_t *)&BOOT_ARGUMENT->dramk_addr,
+		sizeof(BOOT_ARGUMENT->dramk_addr) + sizeof(BOOT_ARGUMENT->dram_size));
 	BOOT_ARGUMENT->magic_number = BOOT_ARGUMENT_MAGIC;
 #endif
 #if defined(SUMMIT_RAM_BOOT)
diff --git a/plat/mediatek/mt8188/platform_bl2.mk b/plat/mediatek/mt8188/platform_bl2.mk
index d5e7dbd50..cff806125 100644
--- a/plat/mediatek/mt8188/platform_bl2.mk
+++ b/plat/mediatek/mt8188/platform_bl2.mk
@@ -9,6 +9,14 @@ ifeq (${PLAT_AB_BOOT_ENABLE},1)
 $(error SUMMIT_EMMC_NO_GPT is incompatible with PLAT_AB_BOOT_ENABLE)
 endif
 $(eval $(call add_define,SUMMIT_EMMC_NO_GPT))
+# libdram Fast-K data: 16 KiB boot-partition region before the U-Boot env, saved by U-Boot via a DRAM handoff.
+SUMMIT_DRAMK_OFFSET ?= 0x3F0000
+SUMMIT_DRAMK_SIZE ?= 0x4000
+SUMMIT_DRAMK_HANDOFF ?= 0x40001000
+$(eval $(call add_define,SUMMIT_DRAMK_OFFSET))
+$(eval $(call add_define,SUMMIT_DRAMK_SIZE))
+$(eval $(call add_define,SUMMIT_DRAMK_HANDOFF))
+BL2_SOURCES += common/tf_crc32.c
 endif
 
 # Download agent: hand off to the U-Boot SPL appended to this image in RAM.
