From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH] mt8188: boot the download agent from RAM

With SUMMIT_RAM_BOOT=1 BL2 skips storage and the FIP, copies the SPL appended
to its payload to DRAM and enters it.

Upstream-Status: Inappropriate [Summit SoM specific]

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
diff --git a/plat/mediatek/mt8188/bl2_plat_setup.c b/plat/mediatek/mt8188/bl2_plat_setup.c
--- a/plat/mediatek/mt8188/bl2_plat_setup.c
+++ b/plat/mediatek/mt8188/bl2_plat_setup.c
@@ -6,6 +6,7 @@
 
 #include <stdint.h>
 
+#include <arch_helpers.h>
 #include <common/bl_common.h>
 #include <common/debug.h>
 #include <drivers/console.h>
@@ -405,6 +406,31 @@
 	(void)result;
 }
 
+#if defined(SUMMIT_RAM_BOOT)
+void bl2_run_next_image(const struct entry_point_info *bl_ep_info);
+void memcpy16(void *dest, const void *src, unsigned int length);
+/*
+ * RAM boot: BootROM loaded this image together with the U-Boot SPL that
+ * follows it. Copy the SPL to DRAM and enter it through the generic BL2 exit
+ * path: AArch64 EL3h, MMU and caches off, interrupts masked, x0..x7 zero.
+ */
+static void __dead2 summit_enter_spl(void)
+{
+	static entry_point_info_t ep;
+
+	/* memcpy16 needs 16-byte aligned addresses. */
+	memcpy16((void *)SUMMIT_SPL_TEXT_BASE,
+		 (const void *)(BL2_BASE + SUMMIT_SPL_OFFSET), SUMMIT_SPL_SIZE);
+	flush_dcache_range(SUMMIT_SPL_TEXT_BASE, SUMMIT_SPL_SIZE);
+
+	SET_PARAM_HEAD(&ep, PARAM_EP, VERSION_1, 0);
+	ep.pc = SUMMIT_SPL_TEXT_BASE;
+	ep.spsr = SPSR_64(MODE_EL3, MODE_SP_ELX, DISABLE_ALL_EXCEPTIONS);
+	bl2_run_next_image(&ep);
+	__builtin_unreachable();
+}
+#endif
+
 void bl2_platform_setup(void)
 {
 	generic_delay_timer_init();
@@ -421,6 +447,12 @@
 	pmic_init();
 	pmic_initial_setting();
 
+#if defined(SUMMIT_RAM_BOOT)
+	/* No storage: libdram finds no blkdev and runs a full calibration. */
+#if !defined(STORAGE_NOR)
+	(void)mt8188_compat;
+#endif
+#else
 #if defined(STORAGE_NOR)
 	mtk_snfc_plat();
 	nor_register_blkdev();
@@ -435,6 +467,7 @@
 	load_partition_table(GPT_IMAGE_ID);
 	blkdev_set_dramk_data_offset(get_part_addr("dramk"));
 	#endif
+#endif
 	mt_mem_init();
 #if defined(SUMMIT_EMMC_NO_GPT)
 	/* Share the detected DRAM capacity through MediaTek's boot arguments. */
@@ -442,9 +475,14 @@
 	BOOT_ARGUMENT->dram_size = platform_memory_size();
 	BOOT_ARGUMENT->magic_number = BOOT_ARGUMENT_MAGIC;
 #endif
+#if defined(SUMMIT_RAM_BOOT)
+	(void)boot_dev_spec;
+	summit_enter_spl();
+#else
 	/* change emmc read buffer to DRAM */
 	boot_dev_spec->buffer.offset = 0x41000000;
 	boot_dev_spec->buffer.length = 0x1000000;
+#endif
 }
 
 struct bl_load_info *plat_get_bl_image_load_info(void)
diff --git a/plat/mediatek/mt8188/platform_bl2.mk b/plat/mediatek/mt8188/platform_bl2.mk
--- a/plat/mediatek/mt8188/platform_bl2.mk
+++ b/plat/mediatek/mt8188/platform_bl2.mk
@@ -11,6 +11,17 @@
 $(eval $(call add_define,SUMMIT_EMMC_NO_GPT))
 endif
 
+# Download agent: hand off to the U-Boot SPL appended to this image in RAM.
+ifeq (${SUMMIT_RAM_BOOT},1)
+SUMMIT_SPL_TEXT_BASE ?= 0x40000000
+SUMMIT_SPL_OFFSET ?= 0x4b000
+SUMMIT_SPL_SIZE ?= 0x25000
+$(eval $(call add_define,SUMMIT_RAM_BOOT))
+$(eval $(call add_define,SUMMIT_SPL_TEXT_BASE))
+$(eval $(call add_define,SUMMIT_SPL_OFFSET))
+$(eval $(call add_define,SUMMIT_SPL_SIZE))
+endif
+
 PLAT_INCLUDES += -I${MTK_PLAT}/common/drivers
 
 BL2_SOURCES += lib/cpus/aarch64/cortex_a55.S \
