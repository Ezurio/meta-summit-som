From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Subject: [PATCH] media: mxc: pass OV5645 UYVY format through CSI bridge

The OV5645 subdevice advertises MEDIA_BUS_FMT_UYVY8_1X16. Allow the
legacy NXP CSI bridge to pass this code through, and map it to the UYVY
capture format so mx6s_capture can enumerate and negotiate it.

Upstream-Status: Inappropriate [legacy code]

---
 drivers/media/platform/mxc/capture/mxc_mipi_csi.c | 4 ++++
 drivers/media/platform/mxc/capture/mx6s_capture.c | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/mxc/capture/mxc_mipi_csi.c b/drivers/media/platform/mxc/capture/mxc_mipi_csi.c
--- a/drivers/media/platform/mxc/capture/mxc_mipi_csi.c
+++ b/drivers/media/platform/mxc/capture/mxc_mipi_csi.c
@@ -320,6 +320,10 @@ static const struct csis_pix_format mipi_csis_formats[] = {
 	}, {
 		.code = MEDIA_BUS_FMT_SBGGR8_1X8,
 		.fmt_reg = MIPI_CSIS_ISPCFG_FMT_RAW8,
 		.data_alignment = 8,
-	}
+	}, {
+		.code = MEDIA_BUS_FMT_UYVY8_1X16,
+		.fmt_reg = MIPI_CSIS_ISPCFG_FMT_YCBCR422_8BIT,
+		.data_alignment = 16,
+	}
 };
diff --git a/drivers/media/platform/mxc/capture/mx6s_capture.c b/drivers/media/platform/mxc/capture/mx6s_capture.c
--- a/drivers/media/platform/mxc/capture/mx6s_capture.c
+++ b/drivers/media/platform/mxc/capture/mx6s_capture.c
@@ -246,5 +246,5 @@ static struct mx6s_fmt formats[] = {
 		.name		= "UYVY-16",
 		.fourcc		= V4L2_PIX_FMT_UYVY,
 		.pixelformat	= V4L2_PIX_FMT_UYVY,
-		.mbus_code	= MEDIA_BUS_FMT_UYVY8_2X8,
+		.mbus_code	= MEDIA_BUS_FMT_UYVY8_1X16,
 		.bpp		= 2,
*** End Patch