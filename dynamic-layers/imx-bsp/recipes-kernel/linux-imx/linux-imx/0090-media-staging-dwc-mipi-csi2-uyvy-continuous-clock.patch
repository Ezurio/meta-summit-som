From: GitHub Copilot <copilot@example.com>
Subject: [PATCH] media: staging: dwc-mipi-csi2: fix OV5645 stream setup

The OV5645 advertises MEDIA_BUS_FMT_UYVY8_1X16, but the staging CSI-2
receiver's format table does not include it. Keep the negotiated format for
the MediaMix gasket configuration.

Add the missing lane stop-state check and propagate initialization failures
from s_stream() instead of proceeding with no frames.

Upstream-Status: Inappropriate [i.MX staging driver fix]

---
 drivers/staging/media/imx/dwc-mipi-csi2.c | 27 ++++++++++++++++++++++-----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/drivers/staging/media/imx/dwc-mipi-csi2.c b/drivers/staging/media/imx/dwc-mipi-csi2.c
--- a/drivers/staging/media/imx/dwc-mipi-csi2.c
+++ b/drivers/staging/media/imx/dwc-mipi-csi2.c
@@ -8,6 +8,7 @@
  *
  */
 
+#include <linux/bitops.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/device.h>
@@ -387,6 +387,9 @@ static const struct csi2h_pix_format dwc_csi2h_formats[] = {
 	{
 		.code = MEDIA_BUS_FMT_YUYV8_2X8,
 		.fmt_reg = 0x18,
+	}, {
+		.code = MEDIA_BUS_FMT_UYVY8_1X16,
+		.fmt_reg = 0x1E,
 	}, {
 		.code = MEDIA_BUS_FMT_RGB888_1X24,
 		.fmt_reg = 0x24,
@@ -758,7 +762,8 @@ static int dwc_mipi_csi2_host_init(struct dwc_mipi_csi2_host *csi2h)
 	struct device *dev = &csi2h->pdev->dev;
 	struct regmap *gasket = csi2h->gasket;
 	struct ipi_config *ipi_cfg = &csi2h->ipi_cfg[0];
-	u32 val, ret;
+	u32 val, phy_stopstate;
+	int ret;
 
   	/* Release Synopsys DPHY test codes from reset */
 	dwc_mipi_csi2h_write(csi2h, DWC_MIPI_CSI2_DPHY_RSTZ, 0x0);
@@ -813,9 +818,11 @@ static int dwc_mipi_csi2_host_init(struct dwc_mipi_csi2_host *csi2h)
 	val  = DWC_MIPI_CSI2_DATA_IDS_VC_1_DI0_VC(ipi_cfg->vir_chan);
 	dwc_mipi_csi2h_write(csi2h, DWC_MIPI_CSI2_DATA_IDS_VC_1, val);
 
-	/* Check that data lanes are in stop state, active 0 or 1? */
+	/* Check that active data lanes are in stop state. */
+	phy_stopstate = GENMASK(csi2h->num_lanes - 1, 0);
 	ret = readl_poll_timeout(csi2h->base_regs + DWC_MIPI_CSI2_DPHY_STOPSTATE,
-			   val, val != 0x10003, 10, 10000);
+			   val, (val & phy_stopstate) == phy_stopstate,
+			   10, 10000);
 	if (ret) {
 		dev_err(dev, "dwc data lane not in stop state, state=%#x\n", val);
 		return ret;
@@ -1150,6 +1157,7 @@ static int dwc_mipi_csi2_set_fmt(struct v4l2_subdev *sd,
 		csi2h_fmt = &dwc_csi2h_formats[0];
 		mf->code = csi2h_fmt->code;
 	}
+	csi2h->format = *mf;
 
 	v4l2_info(&csi2h->sd, "format: %#x\\n", mf->code);
 
@@ -1203,9 +1213,18 @@ static int dwc_mipi_csi2_s_stream(struct v4l2_subdev *sd, int enable)
 	dev_info(&csi2h->pdev->dev, "enter enable=%d\n", enable);
 
 	if (enable) {
-		pm_runtime_get_sync(dev);
+		ret = pm_runtime_get_sync(dev);
+		if (ret < 0) {
+			pm_runtime_put_noidle(dev);
+			return ret;
+		}
 		dwc_mipi_csi2_host_startup(csi2h);
-		dwc_mipi_csi2_host_init(csi2h);
+		ret = dwc_mipi_csi2_host_init(csi2h);
+		if (ret) {
+			dwc_mipi_csi2_host_hs_rx_stop(csi2h);
+			pm_runtime_put(dev);
+			return ret;
+		}
 		dwc_mipi_csi2_host_ipi_config(csi2h);
 		dwc_mipi_csi2_host_hs_rx_start(csi2h);
 		disp_mix_gasket_config(csi2h);
-- 
