Upstream pyproject.toml requires setuptools>=80.8 (for PEP 639 license strings)
and setuptools-scm>=8.3.1.  Our Yocto build has setuptools 76.0.0 and
setuptools-scm 8.2.0.  Fix the license field to use the older dict format,
lower version requirements, and hardcode the version (setuptools-scm cannot
resolve it from a tarball without git metadata).

Upstream-Status: Inappropriate [build system compatibility]

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["setuptools>=80.8", "cython", "setuptools-scm>=8.3.1"]
+requires = ["setuptools", "cython", "setuptools-scm"]
 build-backend = "setuptools.build_meta"
 
 [project]
@@ -24,9 +24,9 @@
     "Topic :: Security :: Cryptography",
 ]
 dependencies = ["asn1crypto>=1.5.1"]
-license = "MIT"
+license = {text = "MIT"}
 requires-python = ">=3.9"
-dynamic = ["version"]
+version = "0.8.1"
 
 [project.urls]
 Homepage = "https://python-pkcs11.readthedocs.io/en/latest/"
